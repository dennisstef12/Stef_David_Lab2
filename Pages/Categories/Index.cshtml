@page
@model Stef_David_Lab2.Pages.Categories.IndexModel

@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Category Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model.CategoryData.Categories)
        {
            <tr>
                <td>
                    <!-- ✅ fiecare categorie e un link -->
                    <a asp-page="./Index" asp-route-id="@category.ID">
                        @category.CategoryName
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.CategoryData.Books != null)
{
    <h2>Books in selected category</h2>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model.CategoryData.Books)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>
                        @(book.Author != null ?
                                        book.Author.FirstName + " " + book.Author.LastName
                                        : "-")
            </td>
        </tr>
                }
        </tbody>
    </table>
}
